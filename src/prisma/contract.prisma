// use prisma-8
enum Role {
  LABOUR
  SHOPKEEPER
  ADMIN
}

enum OrderStatus {
  PENDING
  IN_PRODUCTION
  READY
  DELIVERED
  CANCELLED
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  phone         String?        @unique
  address       String?
  email         String?        @unique
  role          Role
  orders        Order[]
  labourCharges LabourCharge[]
  payments      Payment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @onCreate(now()) @onUpdate(now())
}

model Payment {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Int
  method    String?  // cash, UPI, etc.
  note      String?
  paidAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Product {
  id            Int            @id @default(autoincrement())
  name          String
  price         Int
  stock         Stock?
  orderItems    OrderItem[]
  labourCharges LabourCharge[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @onCreate(now()) @onUpdate(now())
}

model Stock {
  id        Int      @id @default(autoincrement())
  productId Int      @unique
  quantity  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id])
  updatedAt DateTime @onCreate(now()) @onUpdate(now())
}

model Order {
  id          Int         @id @default(autoincrement())
  userId      Int
  status      OrderStatus @default(PENDING)
  totalAmount Int
  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @onCreate(now()) @onUpdate(now())
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model LabourCharge {
  id           Int      @id @default(autoincrement())
  productId    Int
  labourId     Int
  chargeAmount Int
  workDate     DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id])
  labour       User     @relation(fields: [labourId], references: [id])
}